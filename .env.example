# Copy to .env (gitignored) before running `docker compose up` -
#     cp .env.example .env
# Required, not optional (Security Phase 3, ADR 0021): docker-compose.yml no
# longer falls back to a real-looking hardcoded default if this file is
# missing - it fails fast with a clear message instead. The values below are
# fine to keep as-is for local/portfolio use; change them if you want
# different credentials.
DB_NAME=ragplatform
DB_USER=ragplatform
DB_PASSWORD=ragplatform
GRAFANA_ADMIN_PASSWORD=admin
