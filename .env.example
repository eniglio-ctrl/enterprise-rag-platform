# Copy to .env (gitignored) before running `docker compose up` -
#     cp .env.example .env
# Required, not optional (Security Phase 3, ADR 0021): docker-compose.yml no
# longer falls back to a real-looking hardcoded default if this file is
# missing - it fails fast with a clear message instead. The values below are
# fine to keep as-is for local/portfolio use; change them if you want
# different credentials.
DB_NAME=ragplatform
DB_USER=ragplatform
DB_PASSWORD=ragplatform
GRAFANA_ADMIN_PASSWORD=admin

# Security Phase 4 (ADR 0031): a Base64-encoded PKCS8 PEM RSA private key,
# persisted across auth-service restarts instead of being regenerated every
# time (JwtKeyProvider). Unlike the fixed values above, no default is
# committed here - a signing key is sensitive enough (it can forge a token
# for any tenant) that it shouldn't be a shared, publicly-known value even
# for local/portfolio use. Generate your own once and paste it in .env:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 | tr -d '\n'
JWT_SIGNING_KEY=
