# Copy this file to .env.secret (gitignored) and fill in real values before
# running `kubectl apply -k kubernetes/base`. kustomize's secretGenerator
# reads .env.secret to build the rag-platform-db-credentials Secret — nothing
# with real credentials is committed to the repo.
DB_USER=ragplatform
DB_PASSWORD=change-me

# Security Phase 4 (ADR 0031) also needs kubernetes/base/jwt-signing-key.pem
# (gitignored, a separate file - not a line in this one) before `kubectl
# apply -k` will succeed:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out kubernetes/base/jwt-signing-key.pem
